{
  "info": {
    "_postman_id": "73bdc8c3-77ae-453a-92d1-7858ce4279ed",
    "name": "CareerFlow API System Tests",
    "description": "End-to-end system tests for authentication, opportunity CRUD, application CRUD, protected methods, validation, and the modified employment_type field.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('run_id')) {",
          "  const runId = Date.now().toString();",
          "  pm.environment.set('run_id', runId);",
          "  pm.environment.set('recruiter_email', `recruiter.${runId}@example.com`);",
          "  pm.environment.set('candidate_email', `candidate.${runId}@example.com`);",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is under 2000 ms', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "pm.test('Response has a JSON content type', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health endpoint returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Service is healthy', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Protected opportunity creation rejects anonymous user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Unauthorized Role\",\"company\":\"No Token Ltd\",\"location\":\"Remote\",\"description\":\"This must be rejected.\",\"employment_type\":\"Full-time\"}"
        },
        "url": "{{base_url}}/opportunities"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Anonymous mutation returns 401', () => pm.response.to.have.status(401));",
              "pm.test('Authentication error is returned', () => pm.expect(pm.response.json().error).to.include('Authentication required'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Register recruiter",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Postman Recruiter\",\"email\":\"{{recruiter_email}}\",\"password\":\"RecruiterPass123\",\"role\":\"recruiter\"}"
        },
        "url": "{{base_url}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Recruiter registration returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Recruiter role is returned', () => pm.expect(body.role).to.eql('recruiter'));",
              "pm.test('Password is not exposed', () => pm.expect(body).not.to.have.property('password'));",
              "pm.environment.set('recruiter_token', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Register candidate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Postman Candidate\",\"email\":\"{{candidate_email}}\",\"password\":\"CandidatePass123\",\"role\":\"candidate\"}"
        },
        "url": "{{base_url}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Candidate registration returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Candidate role is returned', () => pm.expect(body.role).to.eql('candidate'));",
              "pm.environment.set('candidate_token', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Duplicate registration returns conflict",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Duplicate Candidate\",\"email\":\"{{candidate_email}}\",\"password\":\"CandidatePass123\",\"role\":\"candidate\"}"
        },
        "url": "{{base_url}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Duplicate registration returns 409', () => pm.response.to.have.status(409));",
              "pm.test('Conflict message is useful', () => pm.expect(pm.response.json().error).to.include('already exists'));"
            ]
          }
        }
      ]
    },
