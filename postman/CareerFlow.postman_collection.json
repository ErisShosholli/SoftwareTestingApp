    {
      "name": "10 Create opportunity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{recruiter_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Postman Quality Engineer\",\"company\":\"CareerFlow Labs\",\"location\":\"Budapest / Remote\",\"description\":\"Own API, integration, and system testing.\",\"employment_type\":\"Full-time\"}"
        },
        "url": "{{base_url}}/opportunities"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Opportunity creation returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Modified field is returned', () => pm.expect(body.employment_type).to.eql('Full-time'));",
              "pm.test('New opportunity has no applications', () => pm.expect(body.application_count).to.eql(0));",
              "pm.environment.set('opportunity_id', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 List opportunities",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/opportunities"
